// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

// --------------------------------------------------
// Core Parts Models (Updated for CX)
// --------------------------------------------------

model MainBlade {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @db.VarChar(50)    // e.g., "CX-01-M01"
  name        String   @db.VarChar(255)
  series      String   @db.VarChar(100)   // e.g., "CX-01 Booster"
  releaseDate DateTime? @db.Date
  weight      Float?                       // in grams
  imageUrl    String?  @db.Text
  attack      Int?                         // 0-100 rating
  defense     Int?
  stamina     Int?
  burstResist Int?
  description String?  @db.Text

  // CX Relations
  assemblies  BladeAssemblyMain[]
  combos      Combo[]  // For simple BX/UX fallback if needed

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AssistBlade {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @db.VarChar(50)    // e.g., "CX-01-A01"
  name        String   @db.VarChar(255)           // e.g., "Bumper Assist"
  series      String   @db.VarChar(100)
  releaseDate DateTime? @db.Date
  weight      Float?
  imageUrl    String?  @db.Text
  spinMod     String?  @db.VarChar(50)    // e.g., "Right", "Left", "Dual", "Free-Spin"
  description String?  @db.Text

  // Relations
  assemblies  BladeAssemblyAssist[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LockChip {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @db.VarChar(50)    // e.g., "CX-01-LP"
  name        String   @db.VarChar(100)           // e.g., "Perseus Lock Chip"
  series      String   @db.VarChar(100)
  releaseDate DateTime? @db.Date
  weight      Float?   // Usually ~0.5-1g
  imageUrl    String?  @db.Text
  description String?  @db.Text

  // Relations
  assemblies  BladeAssemblyLockChip[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --------------------------------------------------
// Ratchet & Bit (Unchanged, but new CX variants can be added)
// --------------------------------------------------

model Ratchet {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @db.VarChar(50)    // e.g., "4-55", "6-60"
  name        String   @db.VarChar(100)
  height      String   @db.VarChar(20)    // e.g., "Low", "Mid", "High"
  weight      Float?
  imageUrl    String?  @db.Text

  // Relations
  bladeAssemblies  RatchetBladeAssemblyCompatibility[]  // Updated for assemblies
  bits             RatchetBitCompatibility[]
  combos           ComboRatchet[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Bit {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @db.VarChar(50)    // e.g., "Vortex", "Wedge"
  name        String   @db.VarChar(100)
  type        String   @db.VarChar(50)    // Attack, Defense, Stamina, Balance
  weight      Float?
  imageUrl    String?  @db.Text

  // Relations
  ratchets    RatchetBitCompatibility[]
  combos      ComboBit[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --------------------------------------------------
// Compatibility Tables (Updated for CX Assemblies)
// --------------------------------------------------

model BladeAssemblyMain {
  assemblyId  Int
  mainBladeId Int

  assembly    BladeAssembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  mainBlade   MainBlade     @relation(fields: [mainBladeId], references: [id], onDelete: Cascade)

  @@id([assemblyId, mainBladeId])
  @@index([assemblyId])
  @@index([mainBladeId])
}

model BladeAssemblyAssist {
  assemblyId   Int
  assistBladeId Int

  assembly    BladeAssembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  assistBlade AssistBlade   @relation(fields: [assistBladeId], references: [id], onDelete: Cascade)

  @@id([assemblyId, assistBladeId])
  @@index([assemblyId])
  @@index([assistBladeId])
}

model BladeAssemblyLockChip {
  assemblyId   Int
  lockChipId  Int

  assembly   BladeAssembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  lockChip   LockChip      @relation(fields: [lockChipId], references: [id], onDelete: Cascade)

  @@id([assemblyId, lockChipId])
  @@index([assemblyId])
  @@index([lockChipId])
}

model BladeAssembly {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)  // e.g., "Dran Eclipse Assembly"
  description String? @db.Text
  totalWeight Float?  // Calculated sum of Main + Assist + Lock
  stats     Json?    // Aggregated {attack, defense, etc.} for the assembly

  mains     BladeAssemblyMain[]
  assists   BladeAssemblyAssist[]
  locks     BladeAssemblyLockChip[]
  ratchets  RatchetBladeAssemblyCompatibility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RatchetBladeAssemblyCompatibility {
  ratchetId     Int
  bladeAssemblyId String

  ratchet      Ratchet       @relation(fields: [ratchetId], references: [id], onDelete: Cascade)
  bladeAssembly BladeAssembly @relation(fields: [bladeAssemblyId], references: [id], onDelete: Cascade)

  @@id([ratchetId, bladeAssemblyId])
  @@index([ratchetId])
  @@index([bladeAssemblyId])
}

model RatchetBitCompatibility {
  ratchetId  Int
  bitId      Int

  ratchet    Ratchet  @relation(fields: [ratchetId], references: [id], onDelete: Cascade)
  bit        Bit      @relation(fields: [bitId], references: [id], onDelete: Cascade)

  @@id([ratchetId, bitId])
  @@index([ratchetId])
  @@index([bitId])
}

// --------------------------------------------------
// User-created Combos (Updated for CX)
// --------------------------------------------------

model Combo {
  id               String   @id @default(cuid())
  name             String   @db.VarChar(255)
  description      String?  @db.Text
  isPublic         Boolean  @default(true)

  bladeAssemblyId  String   // For CX; nullable for BX/UX simple blades if added
  ratchetId        Int
  bitId            Int

  bladeAssembly    BladeAssembly @relation(fields: [bladeAssemblyId], references: [id])
  ratchet          Ratchet       @relation("ComboRatchet", fields: [ratchetId], references: [id])
  bit              Bit           @relation("ComboBit", fields: [bitId], references: [id])

  authorId         String?  // For future auth
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([bladeAssemblyId, ratchetId, bitId])
}